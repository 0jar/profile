---
import { defaultLocale, shippedLocales } from "../../../data/site.ts";
import CvPage from "../../../page-templates/CvPage.astro";

export function getStaticPaths() {
  return shippedLocales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<CvPage lang={lang} ats />
