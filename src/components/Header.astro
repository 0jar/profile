---
import { site, type ShippedLocale } from "../data/site.ts";
import { localePath, t } from "../i18n/utils.ts";
import LangSwitcher from "./LangSwitcher.astro";
import NavLinks from "./NavLinks.astro";

interface Props {
  lang: ShippedLocale;
  alternates: Record<ShippedLocale, string>;
}

const { lang, alternates } = Astro.props;
const home = localePath(lang, "/");
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <a class="wordmark" href={home}>
        <img src="/favicon-128.png" alt="" width="32" height="32" aria-hidden="true" loading="eager" fetchpriority="high" />
        <span>∴ {site.displayName}</span>
      </a>
      <nav class="site-nav" aria-label={t(lang, "nav.primary")}>
        <NavLinks lang={lang} home={home} />
      </nav>
    </div>

    <div class="header-right">
      <a class="pill header-email" rel="me" href={`mailto:${site.email}`}>{site.email}</a>
      <LangSwitcher lang={lang} alternates={alternates} />
      <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label={t(lang, "theme.toggle")}>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <span class="theme-label">{t(lang, "theme.toggle")}</span>
      </button>

      <details class="mobile-menu">
        <summary class="mobile-menu-btn" aria-label={t(lang, "nav.menu")}>
          <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </summary>
        <nav class="mobile-menu-panel" aria-label={t(lang, "nav.mobile")}>
          <NavLinks lang={lang} home={home} />
          <a class="mobile-menu-email" rel="me" href={`mailto:${site.email}`}>{site.email}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
