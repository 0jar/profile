---
import { parseEntryId, type ShippedLocale } from "../data/site.ts";
import { localePath, t } from "../i18n/utils.ts";
import { formatDateRange } from "../utils/dates.ts";
import { getEntries } from "../utils/content.ts";

interface Props {
  lang: ShippedLocale;
}

const { lang } = Astro.props;
const projects = await getEntries("projects", lang);
---

<section id="projects" aria-labelledby="projects-title">
  <div class="container">
    <h2 id="projects-title">{t(lang, "projects.title")}</h2>
    <div class="grid">
      {
        projects.map((p) => {
          const { slug } = parseEntryId(p.id);
          return (
            <article class="card" id={`project-${slug}`}>
              <h3>
                <a href={localePath(lang, `/projects/${slug}/`)}>{p.data.title}</a>
              </h3>
              <p class="meta">
                {p.data.role}, {p.data.org} - {formatDateRange(p.data.start, p.data.end, lang)}
              </p>
              <p>{p.data.summary}</p>
              <p>
                {p.data.stack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </p>
              <a href={localePath(lang, `/projects/${slug}/`)}>{t(lang, "projects.readMore")}</a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
