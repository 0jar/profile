{
  "name": "jar-vn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:type": "astro check && tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:gates": "node scripts/check-build.ts",
    "build": "node scripts/check-i18n.ts && astro check && astro build && node scripts/check-build.ts",
    "build:pdf": "astro build && node scripts/build-pdf.ts",
    "build:og": "node scripts/build-og.ts",
    "test:a11y": "node --test tests/a11y-csp.spec.ts",
    "test:lhci": "lhci autorun --config=lighthouserc.cjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "gray-matter": "^4.0.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
